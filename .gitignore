# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production (the desktop icon in build/ is source)
/build/*
!/build/icon.png

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local tooling
.claude/

# Sentry Config File
.env.sentry-build-plugin

# Private notes
CLAUDE.local.md

# Desktop builds
/release

# Offline: the generated starter job list and the server's local state (offline.json)
/public/starter-jobs.json
/.deis-state/

# desktop: bundled at build time by scripts/desktop-prepare.mjs
/desktop/updater.cjs
