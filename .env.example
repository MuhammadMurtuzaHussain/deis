# Deis reads these on the server. The desktop app needs none of them: the user picks
# their own model in the app. The hosted demo sets the first three.

# The demo's own Gemma (Google AI Studio, free tier): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemma-4-26b-a4b-it

# A second Gemma host for when AI Studio returns errors (any OpenAI-compatible server,
# e.g. DigitalOcean serverless inference or OpenRouter).
FALLBACK_BASE_URL=
FALLBACK_API_KEY=
FALLBACK_MODEL=

# The shared Google Jobs feed (SerpApi free plan: 250 searches a month).
SERPAPI_KEY=
SERPAPI_MONTHLY_BUDGET=220

# Set on the hosted demo: rate-limits the demo key and refuses local model URLs.
DEIS_HOSTED=

# Render Key Value (optional; without it the cache lives in memory).
REDIS_URL=

# Sentry (optional): agent traces and guard issues. Never prompts, CVs or keys.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
