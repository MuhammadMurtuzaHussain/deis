# Deis reads these on the server. The desktop app needs none of them: the user picks
# their own model in the app. The hosted demo sets the first three.

# The demo's own Gemma (Google AI Studio, free tier): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=
GOOGLE_MODEL=gemma-4-26b-a4b-it

# Up to two more Gemma hosts for when AI Studio returns errors, asked in this order.
# FALLBACK_* is OpenRouter: https://openrouter.ai/api/v1, google/gemma-4-26b-a4b-it
# (use a key with a credit limit). FALLBACK_2_* is optional: any OpenAI-compatible server.
# Set *_REASONING=omit for a host that refuses reasoning_effort.
FALLBACK_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=google/gemma-4-26b-a4b-it
FALLBACK_REASONING=
FALLBACK_2_BASE_URL=
FALLBACK_2_API_KEY=
FALLBACK_2_MODEL=
FALLBACK_2_REASONING=

# The shared Google Jobs feed (SerpApi free plan: 250 searches a month). The key may be
# shared with other projects: Deis stops searching below SERPAPI_FLOOR searches left.
SERPAPI_KEY=
SERPAPI_MONTHLY_BUDGET=60
SERPAPI_FLOOR=40
SERPAPI_DAILY_BUDGET=20

# Set on the hosted demo: rate-limits the demo key and refuses local model URLs.
DEIS_HOSTED=

# Offline mode: 1 locks it on (only this computer is contacted). Otherwise it's a switch
# in the app, kept in DEIS_STATE_DIR (the desktop app sets it; unset, it lasts until restart).
DEIS_OFFLINE=
DEIS_STATE_DIR=

# Where the desktop app reads the shared job feed (set from desktop/config.json).
DEIS_FEED_URL=

# Render Key Value (optional; without it the cache lives in memory).
REDIS_URL=

# Sentry (optional): agent traces and guard issues. Never prompts, CVs or keys.
# Leave NEXT_PUBLIC_SENTRY_DSN empty when building the desktop app.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Mastra Platform (optional): traces of agent calls and the kit workflow. Never prompts, CVs or outputs.
# An access token and the project id from https://projects.mastra.ai
MASTRA_PLATFORM_ACCESS_TOKEN=
MASTRA_PROJECT_ID=

# Polar (optional): /checkout for the desktop app's Buy button, and /api/webhook/polar.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_SERVER=production
