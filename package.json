{
  "name": "deis",
  "version": "0.1.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "eval": "tsx --env-file=.env.local eval/run.mts",
    "desktop:build": "next build && node scripts/desktop-prepare.mjs",
    "desktop": "electron desktop/main.mjs",
    "dist:mac": "pnpm desktop:build && electron-builder --mac",
    "dist:win": "pnpm desktop:build && electron-builder --win",
    "dist:linux": "pnpm desktop:build && electron-builder --linux"
  },
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@mastra/core": "^1.76.0",
    "@phosphor-icons/react": "^2.1.10",
    "@sentry/nextjs": "^11.6.0",
    "ai": "^7.0.137",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "docx": "^9.10.0",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "motion": "^14.1.0",
    "next": "16.3.8",
    "ollama-ai-provider-v2": "^4.0.1",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "ie.deis.app",
    "productName": "Deis",
    "copyright": "Muhammad Murtuza Hussain, AGPL-3.0",
    "electronVersion": "44.7.0",
    "directories": {
      "app": "desktop",
      "output": "release"
    },
    "extraResources": [
      {
        "from": ".next/standalone",
        "to": "server",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  }
}
