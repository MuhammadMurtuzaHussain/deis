{
  "name": "deis",
  "version": "0.1.3",
  "private": true,
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "next dev -p 3200 -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "lint": "eslint",
    "test": "vitest run",
    "eval": "tsx --env-file=.env.local eval/run.mts",
    "desktop:build": "node scripts/desktop-prepare.mjs --build",
    "desktop": "electron desktop/main.mjs",
    "dist:mac": "pnpm desktop:build && electron-builder --mac",
    "dist:win": "pnpm desktop:build && electron-builder --win",
    "dist:linux": "pnpm desktop:build && electron-builder --linux",
    "eval:seniority": "tsx eval/seniority.mts && tsx eval/seniority.mts holdout"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22 <25"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@mastra/core": "^1.76.0",
    "@phosphor-icons/react": "^2.1.10",
    "@polar-sh/sdk": "^1.0.2",
    "@sentry/nextjs": "^11.6.0",
    "ai": "^7.0.137",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "docx": "^9.10.0",
    "ioredis": "^6.0.0",
    "jszip": "^3.10.2",
    "mammoth": "^1.13.0",
    "motion": "^14.1.0",
    "next": "16.3.8",
    "ollama-ai-provider-v2": "^4.0.1",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  },
  "build": {
    "appId": "ie.deis.app",
    "productName": "Deis",
    "copyright": "Muhammad Murtuza Hussain, AGPL-3.0",
    "electronVersion": "44.7.0",
    "directories": {
      "app": "desktop",
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "artifactName": "Deis-mac-${arch}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "Deis-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office",
      "artifactName": "Deis-linux-${arch}.${ext}"
    },
    "files": [
      "main.mjs",
      "updates.mjs",
      "updater.cjs",
      "package.json",
      "config.json",
      "!**/node_modules/**"
    ],
    "afterPack": "scripts/after-pack.cjs",
    "publish": [
      {
        "provider": "github",
        "owner": "MuhammadMurtuzaHussain",
        "repo": "deis",
        "releaseType": "release"
      }
    ]
  }
}
